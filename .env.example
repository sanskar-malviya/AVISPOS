# ─────────────────────────────────────────────────────────────────────────────
# Aviz Food Point POS — client Firebase config
#
# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase console → Project settings → General → "Your apps" → Web app → Config
#
# These VITE_* values are PUBLIC by design (they ship in the frontend bundle).
# They are NOT secrets — access is controlled by Firestore/Storage Security Rules
# and Firebase Auth, never by hiding these keys. Do NOT put admin/service-account
# keys here; those live only on the server (see scripts/ and functions/).
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to make the app talk to the local Firebase Emulator Suite
# instead of the real cloud project (for local development/testing).
VITE_USE_EMULATORS=false
