rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Avi's Food Corner POS — Firestore security rules (Firebase free Spark plan)
//
// Roles come from Firebase Auth custom claims set by the owner-only `staff`
// Netlify Function (or the one-off bootstrap-owner script):
//   role == 'owner' | 'cashier'.
// Netlify Functions use the Admin SDK and are not subject to these rules.
//
// Audit trail: there are no database triggers on the free plan, so the app
// writes each audit entry in the SAME batch as the change it records, and
// these rules refuse the change without its audit entry (and vice versa).
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner()  { return signedIn() && request.auth.token.role == 'owner'; }
    function isStaff()  {
      return signedIn() && request.auth.token.role in ['owner', 'cashier'];
    }
    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    // ── Products ────────────────────────────────────────────────────────────
    function validProduct(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 40
        && p.pricePaise is int && p.pricePaise > 0 && p.pricePaise <= 9999900
        && p.active is bool && p.available is bool
        && p.sortOrder is number
        // Photos are stored inline as compact JPEG data URLs (max ~400 KB).
        && p.imageUrl is string && p.imageUrl.size() <= 400000
        && p.updatedBy == request.auth.uid;
    }

    // The product's new price is recorded by audit/{lastPriceAuditId}, written
    // in the same batch, with the correct before/after prices and author.
    function priceAudited(productId, beforePaise) {
      let auditId = request.resource.data.lastPriceAuditId;
      let entry = getAfter(docPath('audit', auditId)).data;
      return auditId is string
        && auditId.matches('^price-' + productId + '-[0-9]+$')
        && entry.type == 'price_change'
        && entry.productId == productId
        && entry.beforePaise == beforePaise
        && entry.afterPaise == request.resource.data.pricePaise
        && entry.who == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if isStaff();
      allow create: if isOwner()
        && validProduct(request.resource.data)
        && priceAudited(productId, null);
      allow update: if isOwner()
        && validProduct(request.resource.data)
        && ((request.resource.data.pricePaise == resource.data.pricePaise
              && request.resource.data.get('lastPriceAuditId', '')
                   == resource.data.get('lastPriceAuditId', ''))
            || (request.resource.data.pricePaise != resource.data.pricePaise
              && priceAudited(productId, resource.data.pricePaise)));
      // Never delete products from the app: past orders reference them.
      // Deactivate instead. (The owner-only `products` server function may
      // delete a product after checking that it was never sold.)
      allow delete: if false;
    }

    // ── Orders ──────────────────────────────────────────────────────────────
    function validNewOrder(d, orderId) {
      return d.keys().hasOnly([
          'id', 'orderNumber', 'orderNumberProvisional', 'createdAt', 'clientCreatedAt',
          'dateKey', 'items', 'subtotalPaise', 'grandTotalPaise', 'paymentMethod',
          'paymentStatus', 'status', 'cashierUid', 'deviceId', 'reprintCount',
          'checked', 'validated', 'validationErrors', 'provisionalNumber', 'source',
          'statusReason'])
        && d.id == orderId
        && d.cashierUid == request.auth.uid
        && d.dateKey is string && d.dateKey.matches('^[0-9]{8}$')
        && ((d.orderNumberProvisional == false
              && d.orderNumber.matches('^' + d.dateKey + '-[0-9]{4,}$'))
            || (d.orderNumberProvisional == true
              && d.orderNumber.matches('^OFF-[A-Za-z0-9]+-[0-9]{8}-[0-9]{3,}$')))
        // Server time, not device time, for the official timestamp.
        && d.createdAt == request.time
        && d.clientCreatedAt is int
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.subtotalPaise is int && d.subtotalPaise > 0
        && d.grandTotalPaise == d.subtotalPaise
        // Orders are only ever written once payment is confirmed.
        && d.paymentMethod in ['cash', 'upi']
        && d.paymentStatus == 'paid'
        && d.status == 'completed'
        // Fields only the server may set.
        && d.reprintCount == 0
        && d.checked == false
        && d.validated == false
        && d.validationErrors.size() == 0
        // An online order may carry the device's backup number: the number
        // printed if the server was too slow to answer before the receipt.
        && (d.provisionalNumber == ''
            || (d.orderNumberProvisional == false
              && d.provisionalNumber.matches(
                   '^OFF-' + d.deviceId + '-' + d.dateKey + '-[0-9]{3,}$')))
        && d.statusReason == ''
        && d.source in ['online', 'offline']
        && d.deviceId is string && d.deviceId.matches('^[A-Za-z0-9]{1,32}$');
      // Per-line maths (qty × price, sum of lines) can't be looped over in
      // rules; the process-orders server function re-checks every line
      // against the menu and flags any mismatch.
    }

    function isReprint() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reprintCount'])
        && request.resource.data.reprintCount == resource.data.reprintCount + 1;
    }

    // A refund records how much went back (1 … total, partial allowed) and by
    // which method, so cash and UPI figures stay right. A cancel records neither.
    function isStatusChange(orderId) {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return resource.data.status == 'completed'
        && next.status in ['cancelled', 'refunded']
        && ((next.status == 'cancelled'
              && changed.hasOnly(['status', 'statusReason', 'statusChangedBy', 'statusChangedAt']))
            || (next.status == 'refunded'
              && changed.hasOnly(['status', 'statusReason', 'statusChangedBy', 'statusChangedAt',
                                  'refundPaise', 'refundMethod'])
              && next.refundPaise is int
              && next.refundPaise > 0
              && next.refundPaise <= next.grandTotalPaise
              && next.refundMethod in ['cash', 'upi']))
        && next.statusChangedBy == request.auth.uid
        && next.statusChangedAt == request.time
        && next.statusReason is string
        && next.statusReason.size() > 0
        && next.statusReason.size() <= 200
        // Must be written together with its audit entry.
        && existsAfter(docPath('audit', 'order-' + orderId + '-' + next.status));
    }

    // Correcting how a completed order was paid (e.g. UPI failed, the customer
    // paid cash). Only the method changes — never the amount — and a fresh
    // audit entry must be created in the same batch.
    function isPaymentChange(orderId) {
      let next = request.resource.data;
      let auditId = next.lastPaymentAuditId;
      return resource.data.status == 'completed'
        && next.paymentMethod in ['cash', 'upi']
        && next.paymentMethod != resource.data.paymentMethod
        && next.diff(resource.data).affectedKeys()
             .hasOnly(['paymentMethod', 'paymentChangedBy', 'paymentChangedAt',
                       'lastPaymentAuditId'])
        && next.paymentChangedBy == request.auth.uid
        && next.paymentChangedAt == request.time
        && auditId is string
        && auditId.matches('^order-' + orderId + '-payment-[0-9]+$')
        // A NEW entry: an old one can't be pointed at again.
        && !exists(docPath('audit', auditId))
        && existsAfter(docPath('audit', auditId));
    }

    match /orders/{orderId} {
      // Cashiers may fetch a single order (needed by the idempotent checkout
      // transaction); only owners may list / browse order history.
      allow get: if isStaff();
      allow list: if isOwner();
      allow create: if isStaff() && validNewOrder(request.resource.data, orderId);
      allow update: if (isStaff() && isReprint())
        || (isOwner() && (isStatusChange(orderId) || isPaymentChange(orderId)));
      // Completed sales can never be deleted from the app.
      allow delete: if false;
    }

    // ── Daily order-number counters ─────────────────────────────────────────
    // Can only ever move forward by exactly one, so numbers are never reused.
    match /counters/{dk} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['seq', 'dateKey'])
        && request.resource.data.seq == 1
        && request.resource.data.dateKey == dk;
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['seq', 'dateKey'])
        && request.resource.data.seq == resource.data.seq + 1
        && request.resource.data.dateKey == dk;
      allow delete: if false;
    }

    // ── Settings ────────────────────────────────────────────────────────────
    match /settings/business {
      allow read: if isStaff();
      allow write: if isOwner()
        && (!('paperWidth' in request.resource.data)
            || request.resource.data.paperWidth in ['58', '80']);
    }
    // Owner PIN hash — owners only.
    match /settings/security {
      allow read, write: if isOwner();
    }

    // ── Audit log — append-only ─────────────────────────────────────────────
    // Price-change entry: only alongside the product write that points to it.
    function validPriceAudit(entryId) {
      let a = request.resource.data;
      let product = getAfter(docPath('products', a.productId)).data;
      return a.type == 'price_change'
        && a.keys().hasOnly(['type', 'productId', 'productName', 'beforePaise',
                             'afterPaise', 'who', 'at'])
        && a.productId is string
        && a.who == request.auth.uid
        && a.at == request.time
        && product.lastPriceAuditId == entryId
        && a.afterPaise == product.pricePaise;
    }

    // Cancel/refund entry: only alongside the real status change it describes.
    function validStatusAudit(entryId) {
      let a = request.resource.data;
      let before = get(docPath('orders', a.orderId)).data;
      let after = getAfter(docPath('orders', a.orderId)).data;
      return a.type in ['order_cancel', 'refund']
        && a.keys().hasOnly(['type', 'orderId', 'orderNumber', 'before', 'after',
                             'amountPaise', 'refundMethod', 'reason', 'who', 'at'])
        && a.orderId is string
        && entryId == 'order-' + a.orderId + '-' + a.after
        && (a.type == 'refund') == (a.after == 'refunded')
        && a.before == 'completed' && before.status == 'completed'
        && after.status == a.after
        // The entry states what actually went out: the refund amount and
        // method for a refund, the whole order for a cancellation.
        && ((a.type == 'refund'
              && a.amountPaise == after.refundPaise
              && a.refundMethod == after.refundMethod)
            || (a.type == 'order_cancel'
              && a.amountPaise == after.grandTotalPaise
              && !('refundMethod' in a)))
        && a.orderNumber == after.orderNumber
        && a.reason == after.statusReason
        && a.who == request.auth.uid
        && a.at == request.time;
    }

    // Payment-method correction: only alongside the order update it describes.
    function validPaymentAudit(entryId) {
      let a = request.resource.data;
      let before = get(docPath('orders', a.orderId)).data;
      let after = getAfter(docPath('orders', a.orderId)).data;
      return a.type == 'payment_change'
        && a.keys().hasOnly(['type', 'orderId', 'orderNumber', 'before', 'after',
                             'amountPaise', 'reason', 'who', 'at'])
        && a.orderId is string
        && after.lastPaymentAuditId == entryId
        && a.before == before.paymentMethod
        && a.after == after.paymentMethod
        && a.before != a.after
        && a.amountPaise == after.grandTotalPaise
        && a.orderNumber == after.orderNumber
        && a.reason is string && a.reason.size() <= 200
        && a.who == request.auth.uid
        && a.at == request.time;
    }

    match /audit/{entryId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && ((request.resource.data.type == 'price_change' && validPriceAudit(entryId))
            || (request.resource.data.type in ['order_cancel', 'refund']
                && validStatusAudit(entryId))
            || (request.resource.data.type == 'payment_change'
                && validPaymentAudit(entryId)));
      // Nobody can edit or remove history.
      allow update, delete: if false;
    }

    // ── User profiles (mirror of roles; written only by the server) ─────────
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
  }
}
