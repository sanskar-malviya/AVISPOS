{
  "name": "aviz-food-point-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloud POS for Avi's Food Corner — fast tablet billing for a vegetarian Indian food stall.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aviz-pos \"vitest run -c vitest.rules.config.ts\"",
    "test:e2e": "node tests/e2e/acceptance.mjs",
    "seed": "tsx scripts/seed.ts",
    "bootstrap-owner": "tsx scripts/bootstrap-owner.ts",
    "netlify-admin-env": "tsx scripts/netlify-admin-env.ts",
    "restore-backup": "tsx scripts/restore-backup.ts",
    "emulators": "firebase emulators:start --project demo-aviz-pos",
    "functions:dev": "tsx scripts/dev-functions.ts",
    "dev:emu": "concurrently -k -n emu,fn,web \"firebase emulators:start --project demo-aviz-pos\" \"tsx scripts/dev-functions.ts\" \"vite --mode emulator\"",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "playwright-core": "^1.48.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
