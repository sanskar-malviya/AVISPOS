# Used by `npm run dev:emu` (vite --mode emulator). Points the app at the local
# Firebase Emulator Suite with a "demo-" project — no real cloud project, no
# costs, nothing leaves this computer. These are NOT real credentials.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-aviz-pos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-aviz-pos
VITE_FIREBASE_STORAGE_BUCKET=demo-aviz-pos.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_EMULATORS=true
